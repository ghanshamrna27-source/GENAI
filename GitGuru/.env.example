# ==============================================================================
# GitGuru LLM Environment Configuration Example
# Copy this file to .env and insert your API key:
#   cp .env.example .env
#
# NOTE: Never commit your actual .env file with secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Configuration: Google Gemini (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Alternative models: gemini-3.5-flash, gemini-3.6-flash

# ------------------------------------------------------------------------------
# 2. Secondary Provider: Groq Cloud (https://console.groq.com/keys)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Alternative models: openai/gpt-oss-20b, qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 3. LLM Generation Parameters
# ------------------------------------------------------------------------------
TEMPERATURE=0.2
MAX_TOKENS=1024
DEFAULT_PROMPT_VERSION=v2

# ------------------------------------------------------------------------------
# 4. Service URLs
# ------------------------------------------------------------------------------
GITGURU_API_URL=http://127.0.0.1:8000
