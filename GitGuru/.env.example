# ==============================================================================
# GitGuru LLM Environment Configuration Example
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
#
# NOTE: Never commit your actual .env file with secrets to Git!
# ==============================================================================

# LLM Provider selection: 'groq' or 'gemini' (defaults to 'groq' if key present)
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# Groq Cloud API Configuration (https://console.groq.com/keys)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models: llama-3.1-8b-instant, mixtral-8x7b-32768

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Alternative models: gemini-2.0-flash, gemini-1.5-pro

# ------------------------------------------------------------------------------
# LLM Generation Parameters
# ------------------------------------------------------------------------------
TEMPERATURE=0.2
MAX_TOKENS=1024
DEFAULT_PROMPT_VERSION=v2

